{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "舞台大师",
  "version": "0.1.0",
  "identifier": "cn.stagemaster.desktop",
  "build": {
    "beforeBuildCommand": "npm --prefix ui-prototype run build",
    "beforeDevCommand": "npm --prefix ui-prototype run dev -- --port 1420 --strictPort",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../ui-prototype/dist/client"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "舞台大师",
        "width": 1440,
        "height": 940,
        "minWidth": 1100,
        "minHeight": 800,
        "backgroundColor": "#0d1720",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost ws://127.0.0.1:*; object-src 'none'; base-uri 'self'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "category": "Music",
    "shortDescription": "舞台灯光编排工作台",
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
